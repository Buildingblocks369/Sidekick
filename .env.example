# ─────────────────────────────────────────────────────────────────────────────
# Sidekick server settings: TEMPLATE ONLY. This file contains NO real secrets.
#
# To use it:  copy this file to  .env.local  and edit the copy.
#   cp .env.example .env.local
# .env.local is ignored by git, so your key is never committed.
#
# RULES:
#  * NEVER put a real key in this file (.env.example) or in any file that is committed.
#  * NEVER add NEXT_PUBLIC_ in front of a name here. That would send it to the browser.
#  * If you leave everything below as-is, Sidekick runs in free DEMO MODE.
# ─────────────────────────────────────────────────────────────────────────────

# Switch 1 of 2. Live AI only happens when this is exactly "true" AND a key is set.
SIDEKICK_AI_ENABLED=false

# Switch 2 of 2. Paste your OpenAI key in .env.local only. Leave empty here.
OPENAI_API_KEY=

# Provider and model. Pin the model name so a provider change can't silently change cost.
AI_PROVIDER=openai
AI_MODEL=gpt-6-luna
# "none" = no hidden thinking tokens: cheapest and fastest. (OpenAI's own default is "medium",
# which costs more and is slower, so Sidekick sets "none" explicitly.)
AI_REASONING_EFFORT=none

# Per-reply limits (code enforces upper bounds: 1000 tokens, 60 seconds).
AI_MAX_OUTPUT_TOKENS=500
AI_TIMEOUT_MS=25000

# Application spending caps in US dollars. These are ESTIMATES kept by Sidekick.
# They cannot guarantee your real OpenAI bill. See README.
# Code enforces a hard ceiling of $5 total, whatever you type here.
SPEND_CAP_TOTAL_USD=2
SPEND_CAP_DAILY_USD=0.5
SPEND_CAP_SESSION_DAILY_USD=0.05

# Fair-use limits for anonymous visitors.
LIMIT_SESSION_DAILY_MESSAGES=30
LIMIT_SESSION_PER_MINUTE=8
LIMIT_IP_PER_MINUTE=20
LIMIT_GLOBAL_PER_MINUTE=60
LIMIT_MAX_CONCURRENT=3
